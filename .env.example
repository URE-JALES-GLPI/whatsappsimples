# ==============================================================================
# WHATSAPP SIMPLES / URE OMNICHANNEL - CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# NUNCA comite o arquivo .env no repositório!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EVOLUTION API (Serviço de WhatsApp)
# ------------------------------------------------------------------------------
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_global_evolution_aqui
EVOLUTION_INSTANCE_NAME=atendimento

# ------------------------------------------------------------------------------
# 2. MERCURE HUB (Eventos em tempo real / SSE)
# ------------------------------------------------------------------------------
MERCURE_HUB_URL=http://localhost:3001/.well-known/mercure
MERCURE_JWT_KEY=sua_chave_jwt_super_secreta_mercure_aqui
MERCURE_TOPIC=chats_ure_jales

# ------------------------------------------------------------------------------
# 3. DOCKER COMPOSE - POSTGRESQL & REDIS (Para a Evolution API)
# ------------------------------------------------------------------------------
POSTGRES_DB=evolution_db
POSTGRES_USER=evolution
POSTGRES_PASSWORD=sua_senha_segura_postgres_aqui

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6

# ------------------------------------------------------------------------------
# 4. GLPI REST API (Opcional - Apenas para scripts CLI / Node que interagem com o GLPI)
# ------------------------------------------------------------------------------
GLPI_BASE_URL=http://localhost/glpi
GLPI_APP_TOKEN=seu_glpi_app_token_aqui
GLPI_USER_TOKEN=seu_glpi_user_token_aqui

# ------------------------------------------------------------------------------
# 5. BANCO DE DADOS GLPI (Apenas para scripts CLI autônomos como diagnostico.php)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=glpi_db
DB_USER=glpi_db_user
DB_PASS=sua_senha_mysql_glpi_aqui

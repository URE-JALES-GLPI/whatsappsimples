# Aumenta os limites para recepcao de arquivos pesados via Webhook
<IfModule mod_php.c>
    php_value post_max_size 128M
    php_value upload_max_filesize 128M
    php_value memory_limit 512M
    php_value max_execution_time 120
</IfModule>
<IfModule mod_php7.c>
    php_value post_max_size 128M
    php_value upload_max_filesize 128M
    php_value memory_limit 512M
    php_value max_execution_time 120
</IfModule>
<IfModule mod_php8.c>
    php_value post_max_size 128M
    php_value upload_max_filesize 128M
    php_value memory_limit 512M
    php_value max_execution_time 120
</IfModule>
